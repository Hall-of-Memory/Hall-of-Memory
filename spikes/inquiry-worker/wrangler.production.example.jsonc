{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "REPLACE_WITH_CUSTOMER_OWNED_INQUIRY_WORKER",
  "main": "src/privacy-entry.ts",
  "compatibility_date": "2026-08-11",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_CUSTOMER_OWNED_D1_NAME",
      "database_id": "REPLACE_WITH_REMOTE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {"name":"PUBLIC_ROUTE_LIMITER","namespace_id":"REPLACE_WITH_ROUTE_NAMESPACE_ID","simple":{"limit":120,"period":60}},
    {"name":"PUBLIC_ACTOR_LIMITER","namespace_id":"REPLACE_WITH_ACTOR_NAMESPACE_ID","simple":{"limit":5,"period":60}}
  ],
  "send_email": [
    {
      "name": "NOTIFY_OWNER",
      "allowed_destination_addresses": ["REPLACE_WITH_VERIFIED_OWNER_EMAIL"],
      "allowed_sender_addresses": ["REPLACE_WITH_VERIFIED_SENDER_EMAIL"]
    }
  ],
  "vars": {
    "SPIKE_MODE": "production",
    "ACCESS_TEAM_DOMAIN": "https://REPLACE_WITH_ACCESS_TEAM_DOMAIN",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUDIENCE",
    "NOTIFY_TO": "REPLACE_WITH_VERIFIED_OWNER_EMAIL",
    "NOTIFY_FROM": "REPLACE_WITH_VERIFIED_SENDER_EMAIL",
    "PUBLIC_SITE_ORIGIN": "https://REPLACE_WITH_PUBLIC_SITE_HOST"
  }
}
