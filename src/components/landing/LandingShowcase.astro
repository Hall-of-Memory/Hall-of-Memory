---
interface Offer {
  title: string;
  kicker: string;
  description: string;
  moreInfo: string;
  motif: 'flash' | 'mirror' | 'editorial';
  highlights: string[];
}

interface Benefit {
  title: string;
  text: string;
}

interface Step {
  number: string;
  title: string;
  text: string;
}

interface Props {
  offers: Offer[];
  benefits: Benefit[];
  steps: Step[];
  productWhatsAppHref: (product: string) => string | undefined;
}

const { offers, benefits, steps, productWhatsAppHref } = Astro.props;
---
<section class="hom-products" id="angebote" aria-labelledby="hom-products-title">
  <div class="shell">
    <header class="hom-section-heading">
      <p class="eyebrow">Drei Erlebnisse · ein Erinnerungsgefühl</p>
      <h2 id="hom-products-title">Welcher Moment passt <em>zu deinem Event?</em></h2>
      <p>Fotobox, Fotospiegel oder Magazinbox: Alle drei Angebote setzen den Fotomoment anders in Szene. Die Details stimmen wir passend zu deinem Anlass ab.</p>
    </header>

    <div class="hom-product-grid">
      {offers.map((offer, index) => (
        <article class="demo-offer-card hom-product-card" data-motif={offer.motif}>
          <div class="hom-product-visual" aria-hidden="true">
            <span class="hom-product-number">0{index + 1}</span>
            <span class="hom-product-star">★</span>
            <strong>{offer.title}</strong>
          </div>
          <div class="hom-product-body">
            <p class="hom-product-kicker">{offer.kicker}</p>
            <h3>{offer.title}</h3>
            <p>{offer.description}</p>
            <ul>
              {offer.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
            <details class="demo-offer-details">
              <summary>Mehr erfahren <span aria-hidden="true">+</span></summary>
              <p>{offer.moreInfo}</p>
            </details>
            <div class="hom-product-actions">
              <a href="#anfrage">Unverbindlich anfragen</a>
              {productWhatsAppHref(offer.title) && (
                <a
                  href={productWhatsAppHref(offer.title)}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`WhatsApp-Anfrage zur ${offer.title}`}
                >WhatsApp</a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="hom-benefits" aria-labelledby="hom-benefits-title">
  <div class="shell">
    <header class="hom-section-heading hom-section-heading-compact">
      <p class="eyebrow">Warum Hall of Memory</p>
      <h2 id="hom-benefits-title">Ein Erlebnis, das <em>in Erinnerung bleibt.</em></h2>
    </header>
    <div class="hom-benefit-grid">
      {benefits.map((benefit, index) => (
        <article>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{benefit.title}</h3>
          <p>{benefit.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="hom-packages" id="pakete" aria-labelledby="hom-packages-title">
  <div class="shell hom-packages-grid">
    <div>
      <p class="eyebrow">Pakete</p>
      <h2 id="hom-packages-title">So viel wie nötig. <em>So persönlich wie dein Event.</em></h2>
    </div>
    <div class="hom-packages-copy">
      <p>Pakete und Preise werden nach der finalen Kundenfreigabe veröffentlicht. Bis dahin klären wir im Anfragebereich, welches Erlebnis und welcher Umfang zu deinem Anlass passen.</p>
      <ul>
        <li>Produkt und Eventart zuerst klären</li>
        <li>Wünsche und gewünschte Ausstattung abstimmen</li>
        <li>Danach ein passendes Angebot erhalten</li>
      </ul>
      <a href="#anfrage">Paket gemeinsam auswählen <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<section class="hom-gallery" id="galerie" aria-labelledby="hom-gallery-title">
  <div class="shell">
    <header class="hom-section-heading hom-section-heading-light">
      <p class="eyebrow">Galerie</p>
      <h2 id="hom-gallery-title">Momente bekommen <em>eine Bühne.</em></h2>
      <p>Die finalen Kundenfotos folgen nach Freigabe. Bis dahin zeigt die Galerie bewusst nur die gestalterische Richtung – ohne fremde oder erfundene Produktbilder.</p>
    </header>
    <ul class="hom-gallery-grid" aria-label="Gestalterische Platzhalter für künftige Kundenfotos">
      <li><span>Fotobox</span><strong>Spontane Momente</strong></li>
      <li><span>Fotospiegel</span><strong>Großer Auftritt</strong></li>
      <li><span>Magazinbox</span><strong>Cover-Moment</strong></li>
      <li><span>Hall of Memory</span><strong>Dein Event im Mittelpunkt</strong></li>
    </ul>
  </div>
</section>

<section class="hom-process" id="ablauf" aria-labelledby="hom-process-title">
  <div class="shell">
    <header class="hom-section-heading hom-section-heading-compact">
      <p class="eyebrow">So funktioniert’s</p>
      <h2 id="hom-process-title">Vom ersten Wunsch <em>zum Erinnerungsmoment.</em></h2>
    </header>
    <ol class="hom-process-grid">
      {steps.map((step) => (
        <li>
          <span>{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="hom-customer" id="kundenbereich" aria-labelledby="hom-customer-title">
  <div class="shell hom-customer-grid">
    <div>
      <p class="eyebrow">Nach dem Event</p>
      <h2 id="hom-customer-title">Deine Erinnerungen. <em>Persönlich gesammelt.</em></h2>
      <p>Nach dem Event kann deine Galerie über einen persönlichen Link oder Code erreichbar sein. Der konkrete Zugang wird erst mit dem freigegebenen Kundenbereich eingerichtet.</p>
    </div>
    <aside class="hom-customer-card" aria-label="Vorschau des persönlichen Kundenbereichs">
      <span class="hom-customer-star" aria-hidden="true">★</span>
      <p>Hall of Memory</p>
      <strong>Dein persönlicher Bereich</strong>
      <small>Fotos ansehen · Erinnerungen wiederfinden</small>
      <span class="hom-customer-preview">Vorschau Kundenbereich</span>
    </aside>
  </div>
</section>
