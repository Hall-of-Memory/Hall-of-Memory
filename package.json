{
  "name": "hall-of-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-production-readiness.mjs --if-production && astro build",
    "build:verification": "astro build",
    "build:pages": "astro build --base /Hall-of-Memory && node scripts/prepare-pages-artifact.mjs dist .pages-artifact",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "npm run check:production-readiness && npm run build && wrangler deploy",
    "verify": "node scripts/run-verification.mjs",
    "check:install-state": "node scripts/check-installed-dependencies.mjs",
    "check:production-readiness": "node scripts/check-production-readiness.mjs",
    "test:install-state": "node scripts/test-installed-dependencies.mjs",
    "test:verification-runner": "node scripts/test-verification-runner.mjs",
    "test:release-safety": "node scripts/test-production-readiness.mjs && node --experimental-strip-types scripts/test-security-policy.mjs && node scripts/test-pages-deployment-contract.mjs",
    "test:admin-privacy": "node --experimental-strip-types scripts/test-admin-data-minimization.mjs && node --experimental-strip-types scripts/test-admin-page-security.mjs",
    "test:inquiry-contract": "node --experimental-strip-types scripts/test-inquiry-contract.mjs",
    "test:inquiry-migrations": "node scripts/test-inquiry-migrations.mjs",
    "test:dns-cutover": "node scripts/test-dns-zone-cutover.mjs",
    "test:domain": "node --experimental-strip-types scripts/test-availability.mjs",
    "test:gallery-access": "node --experimental-strip-types scripts/test-gallery-access.mjs",
    "test:form": "PUBLIC_INQUIRY_API_URL=https://inquiry.example.invalid/api/inquiries PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA astro build --outDir .form-test-dist && node --experimental-strip-types scripts/test-inquiry-form.mjs",
    "test:quality": "PUBLIC_SITE_URL=https://site.example.invalid PUBLIC_INQUIRY_API_URL=https://inquiry.example.invalid/api/inquiries PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA astro build --outDir .quality-test-dist && node --experimental-strip-types scripts/test-quality.mjs",
    "test:demo": "PUBLIC_SITE_URL=https://site.example.invalid astro build --outDir .demo-test-dist && node --experimental-strip-types scripts/test-sales-demo.mjs",
    "test:visual-startup": "node scripts/test-visual-browser-startup.mjs",
    "test:visual": "PUBLIC_SITE_URL=https://site.example.invalid astro build --outDir .visual-test-dist && node scripts/test-visual-regression.mjs .visual-test-dist visual-test-artifacts",
    "test:fundus-corner": "PUBLIC_SITE_URL=https://site.example.invalid astro build --outDir .fundus-corner-test-dist && node scripts/test-fundus-corner.mjs",
    "dry-run:worker": "WRANGLER_LOG_PATH=/tmp/hall-of-memory-worker-wrangler.log wrangler deploy --dry-run --config spikes/inquiry-worker/wrangler.jsonc --outdir /tmp/hall-of-memory-inquiry-worker-dry",
    "dry-run:worker:production": "WRANGLER_LOG_PATH=/tmp/hall-of-memory-production-worker-wrangler.log wrangler deploy --dry-run --config spikes/inquiry-worker/wrangler.production.jsonc --outdir /tmp/hall-of-memory-inquiry-worker-production-dry",
    "dry-run:site": "WRANGLER_LOG_PATH=/tmp/hall-of-memory-site-wrangler.log wrangler deploy --dry-run --config wrangler.jsonc --outdir /tmp/hall-of-memory-static-site-dry",
    "spike:inquiry": "WRANGLER_LOG_PATH=/tmp/hall-of-memory-spike-wrangler.log node --experimental-strip-types scripts/smoke-inquiry-spike.mjs",
    "spike:admin": "WRANGLER_LOG_PATH=/tmp/hall-of-memory-spike-wrangler.log node --experimental-strip-types scripts/smoke-inquiry-spike.mjs",
    "test:preview-base": "astro --base /hall-of-memory-preview build --outDir .preview-base-test-dist && node scripts/test-preview-base.mjs",
    "test:pages-artifact": "astro --base /Hall-of-Memory build --outDir .pages-artifact-source-test-dist && node scripts/test-pages-artifact.mjs"
  },
  "dependencies": {
    "astro": "7.2.4",
    "jose": "6.2.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "parse5": "8.0.1",
    "typescript": "6.0.3",
    "wrangler": "4.127.0"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  }
}
