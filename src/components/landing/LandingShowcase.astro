---
interface Offer {
  title: string;
  kicker: string;
  description: string;
  moreInfo: string;
  motif: 'flash' | 'mirror' | 'editorial';
  highlights: string[];
}

interface Benefit {
  title: string;
  text: string;
}

interface Step {
  number: string;
  title: string;
  text: string;
}

interface Props {
  offers: Offer[];
  benefits: Benefit[];
  steps: Step[];
  productWhatsAppHref: (product: string) => string | undefined;
}

const { offers, benefits, steps, productWhatsAppHref } = Astro.props;
const assetBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const sampleEventImage = `${assetBase}demo/hall-of-memory-example-event.webp`;
---
<section class="demo-section demo-offers shell" id="angebote" aria-labelledby="offers-title">
  <header class="demo-section-heading">
    <div>
      <p class="eyebrow">Unsere Erlebnisse</p>
      <h2 id="offers-title">Was darf auf deinem Event<br /><em>nicht fehlen?</em></h2>
    </div>
    <p>
      Drei Erlebnisse, klar auf einen Blick. Die Bilder sind aktuell noch Platzhalter und werden
      später durch echte Hall-of-Memory-Aufnahmen ersetzt.
    </p>
  </header>

  <div class="demo-offer-grid">
    {offers.map((offer, index) => (
      <article class="demo-offer-card">
        <div class={`demo-offer-media demo-offer-media-${offer.motif}`}>
          <img
            class="hom-offer-photo"
            src={sampleEventImage}
            alt={`Beispielhafte Eventaufnahme als Platzhalter für ${offer.title}`}
            width="1122"
            height="1402"
            loading="lazy"
            decoding="async"
          />
          <div class="hom-offer-photo-shade" aria-hidden="true"></div>
          <div class="demo-offer-number" aria-hidden="true">0{index + 1}</div>
          <div class="hom-offer-icon" aria-hidden="true">
            <svg viewBox="0 0 320 240" focusable="false">
              {offer.motif === 'flash' && (
                <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M89 69h142c10 0 17 7 17 17v98H72V86c0-10 7-17 17-17Z" />
                  <path d="M104 54h112l11 15H93l11-15ZM104 184v24h112v-24M126 208h68" />
                  <circle cx="160" cy="122" r="39" /><circle cx="160" cy="122" r="26" /><circle cx="160" cy="122" r="8" />
                </g>
              )}
              {offer.motif === 'mirror' && (
                <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M102 209V103c0-45 25-72 58-72s58 27 58 72v106H102Z" />
                  <path d="M118 191v-84c0-33 18-55 42-55s42 22 42 55v84h-84Z" opacity=".78" />
                  <path d="M92 209h136M112 209l-18 21M208 209l18 21M84 230h43M193 230h43" />
                </g>
              )}
              {offer.motif === 'editorial' && (
                <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M82 32h156v176H82zM99 49h122v142H99z" />
                  <path d="M113 68h94M121 77h78M109 172h102M121 181h78" opacity=".68" />
                  <circle cx="160" cy="115" r="22" />
                  <path d="M122 161c6-27 19-42 38-42s32 15 38 42" opacity=".62" />
                </g>
              )}
            </svg>
          </div>
          <span class="demo-media-label">{offer.title}</span>
        </div>
        <div class="demo-offer-copy">
          <p class="offer-kicker">{offer.kicker}</p>
          <h3>{offer.title}</h3>
          <p>{offer.description}</p>
          <ul>
            {offer.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          <details class="demo-offer-details">
            <summary>Mehr erfahren <span aria-hidden="true">+</span></summary>
            <p>{offer.moreInfo}</p>
          </details>
          <div class="demo-card-actions">
            <a class="demo-card-cta" href="#anfrage">Unverbindlich anfragen</a>
            {productWhatsAppHref(offer.title) && (
              <a
                class="demo-card-whatsapp"
                href={productWhatsAppHref(offer.title)}
                target="_blank"
                rel="noopener noreferrer"
              >WhatsApp</a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<section class="demo-benefits" aria-labelledby="benefits-title">
  <div class="shell">
    <header class="demo-compact-heading">
      <p class="eyebrow">Warum Hall of Memory</p>
      <h2 id="benefits-title">Mehr Erlebnis.<br /><em>Weniger Ablenkung.</em></h2>
    </header>
    <div class="demo-benefit-grid">
      {benefits.map((benefit, index) => (
        <article>
          <span aria-hidden="true">0{index + 1}</span>
          <h3>{benefit.title}</h3>
          <p>{benefit.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="demo-section demo-packages shell" id="pakete" aria-labelledby="packages-title">
  <header class="demo-section-heading">
    <div>
      <p class="eyebrow">Pakete</p>
      <h2 id="packages-title">Schnell verstehen.<br /><em>Einfach vergleichen.</em></h2>
    </div>
    <p>
      Pakete machen Leistungen und Preise auf einen Blick vergleichbar. Bis die konkreten
      Varianten feststehen, beraten wir dich persönlich zur passenden Zusammenstellung.
    </p>
  </header>
  <div class="demo-package-grid">
    <article class="demo-package-card demo-package-card-pending">
      <div class="demo-package-topline"><span>Pakete & Preise</span><p>Persönlich abgestimmt</p></div>
      <h3>Klar vergleichen.<br />Passend auswählen.</h3>
      <p>Die Paketvarianten für Fotobox, Fotospiegel und Magazinbox werden mit Leistungen und Preisen transparent gegenübergestellt.</p>
      <div class="demo-package-meta">
        <span>Aktuell</span><strong>Persönliche Paketberatung</strong>
        <span>Erlebnisse</span><strong>Fotobox · Fotospiegel · Magazinbox</strong>
      </div>
      <a href="#anfrage">Paket gemeinsam auswählen <span aria-hidden="true">→</span></a>
    </article>
  </div>
</section>

<section class="demo-gallery hom-lookbook" id="galerie" aria-labelledby="gallery-title">
  <div class="shell">
    <header class="demo-section-heading demo-gallery-heading">
      <div>
        <p class="eyebrow">Look & Feel</p>
        <h2 id="gallery-title">Mehr Bilder.<br /><em>Mehr Gefühl.</em></h2>
      </div>
      <p>
        Diese Bildflächen zeigen jetzt bereits die spätere Richtung. Sobald deine eigenen Fotos
        fertig sind, ersetzen wir die Platzhalter ohne das Layout neu bauen zu müssen.
      </p>
    </header>
    <div class="demo-gallery-grid" aria-label="Galerievorschau">
      <figure class="demo-gallery-tile demo-gallery-tile-main hom-photo-tile">
        <img src={sampleEventImage} alt="Beispielhafte Eventaufnahme" width="1122" height="1402" loading="lazy" decoding="async" />
        <figcaption><span>Eventgefühl</span><strong>Der Moment steht im Mittelpunkt.</strong></figcaption>
      </figure>
      <figure class="demo-gallery-tile demo-gallery-tile-photo hom-photo-tile hom-photo-tile-a">
        <img src={sampleEventImage} alt="Beispielhafte Eventaufnahme für die Fotobox" width="1122" height="1402" loading="lazy" decoding="async" />
        <figcaption><span>Fotobox</span><strong>Spontane Momente</strong></figcaption>
      </figure>
      <figure class="demo-gallery-tile demo-gallery-tile-photo hom-photo-tile hom-photo-tile-b">
        <img src={sampleEventImage} alt="Beispielhafte Eventaufnahme für den Fotospiegel" width="1122" height="1402" loading="lazy" decoding="async" />
        <figcaption><span>Fotospiegel</span><strong>Elegante Präsenz</strong></figcaption>
      </figure>
      <figure class="demo-gallery-tile demo-gallery-tile-photo hom-photo-tile hom-photo-tile-c">
        <img src={sampleEventImage} alt="Beispielhafte Eventaufnahme für die Magazinbox" width="1122" height="1402" loading="lazy" decoding="async" />
        <figcaption><span>Magazinbox</span><strong>Editorialer Moment</strong></figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="demo-section demo-process shell" id="ablauf" aria-labelledby="process-title">
  <header class="demo-section-heading">
    <div>
      <p class="eyebrow">So funktioniert’s</p>
      <h2 id="process-title">Vom ersten Klick<br /><em>bis zur eigenen Galerie.</em></h2>
    </div>
    <p>In vier klaren Schritten kommst du vom passenden Erlebnis bis zu deinen Erinnerungen nach dem Event.</p>
  </header>
  <ol class="demo-step-grid">
    {steps.map((step) => (
      <li>
        <span>{step.number}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>
</section>

<section class="demo-customer-area" id="kundenbereich" aria-labelledby="customer-area-title">
  <div class="shell demo-customer-area-grid">
    <div class="demo-customer-copy">
      <p class="eyebrow">Nach dem Event</p>
      <h2 id="customer-area-title">Deine Erinnerungen.<br /><em>Nur für dich.</em></h2>
      <p>
        Nach deinem Event führt dein persönlicher Zugang direkt zu den Erinnerungen deiner
        Veranstaltung. Du siehst ausschließlich deine eigene Galerie – bequem auch unterwegs.
      </p>
      <ul>
        <li>persönlicher Link oder Code</li>
        <li>nur die Bilder deiner Veranstaltung</li>
        <li>für Smartphone und Tablet gedacht</li>
        <li>Zugang bei Bedarf erneuerbar</li>
      </ul>
    </div>
    <div class="demo-access-card" aria-label="Visualisierung des persönlichen Galerie-Zugangs">
      <div class="demo-access-icon" aria-hidden="true">
        <svg viewBox="0 0 64 64"><path d="M18 29v-9c0-8 6-14 14-14s14 6 14 14v9M12 29h40v29H12z"/><circle cx="32" cy="43" r="4"/><path d="M32 47v6"/></svg>
      </div>
      <p>Persönliche Galerie</p>
      <strong>Deine Veranstaltung</strong>
      <span>geschützter Zugang</span>
      <div class="demo-access-rule"><i></i><i></i><i></i></div>
      <small>Nur deine Veranstaltung.</small>
      <details class="demo-access-preview">
        <summary>Beispielzugang ansehen</summary>
        <div><span>01 · Zugang öffnen</span><span>02 · Event aufrufen</span><span>03 · Erinnerungen ansehen</span></div>
      </details>
    </div>
  </div>
</section>
