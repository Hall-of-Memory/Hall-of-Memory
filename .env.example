# Public build-time values only. Keep them empty until the real customer-owned
# origins, Turnstile widget and contact destination exist; an empty configuration
# remains fail-closed and must never be replaced by guessed customer data.
PUBLIC_SITE_URL=
PUBLIC_INQUIRY_API_URL=
PUBLIC_TURNSTILE_SITE_KEY=

# Hall of Memory WhatsApp Business number in international format, digits only,
# e.g. 491701234567. Leave empty until the customer supplies the actual number.
PUBLIC_WHATSAPP_NUMBER=
