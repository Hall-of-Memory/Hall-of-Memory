{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hall-of-memory-inquiry-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "d1_databases": [{"binding":"DB","database_name":"hall-of-memory-inquiry-spike","database_id":"00000000-0000-0000-0000-000000000001","migrations_dir":"migrations"}],
  "ratelimits": [
    {"name":"PUBLIC_ROUTE_LIMITER","namespace_id":"11001","simple":{"limit":120,"period":60}},
    {"name":"PUBLIC_ACTOR_LIMITER","namespace_id":"11002","simple":{"limit":5,"period":60}},
    {"name":"SMOKE_LIMITER","namespace_id":"11999","simple":{"limit":2,"period":10}}
  ],
  "send_email": [{"name":"NOTIFY_OWNER","allowed_destination_addresses":["owner@example.invalid"],"allowed_sender_addresses":["anfragen@hall-of-memory.invalid"]}],
  "vars": {
    "SPIKE_MODE":"local-only",
    "TURNSTILE_SECRET_KEY":"1x0000000000000000000000000000000AA",
    "ACCESS_TEAM_DOMAIN":"https://local-test.cloudflareaccess.invalid",
    "ACCESS_AUD":"local-admin-audience",
    "NOTIFY_TO":"owner@example.invalid",
    "NOTIFY_FROM":"anfragen@hall-of-memory.invalid",
    "PUBLIC_SITE_ORIGIN":"http://127.0.0.1:4321"
  }
}
