---
interface Offer {
  title: string;
  kicker: string;
  description: string;
  moreInfo: string;
  motif: 'flash' | 'mirror' | 'editorial';
  highlights: string[];
}

interface Benefit {
  title: string;
  text: string;
}

interface Step {
  number: string;
  title: string;
  text: string;
}

interface Props {
  offers: Offer[];
  benefits: Benefit[];
  steps: Step[];
  productWhatsAppHref: (product: string) => string | undefined;
}

const { offers, benefits, productWhatsAppHref } = Astro.props;
const assetBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const sampleEventImage = `${assetBase}demo/hall-of-memory-example-event.webp`;
const whatsappHref = productWhatsAppHref('Fotobox');

const packageOptions = [
  { id: 'digital', name: 'Digital', detail: 'Alle Bilder digital in hochwertiger Qualität.' },
  { id: 'starter', name: 'Starter', detail: 'Für kompakte Events und einen klaren Einstieg.' },
  { id: 'gold', name: 'Gold', detail: 'Der ausgewogene Hall-of-Memory Favorit.', popular: true },
  { id: 'star', name: 'Star', detail: 'Mehr Umfang für große Erinnerungen.' },
  { id: 'all-inclusive', name: 'All Inclusive', detail: 'Das Rundum-Paket für dein Event.' },
];

const extras = [
  { id: 'background', name: 'Hintergrundsystem', detail: 'Fotohintergrund passend zu deinem Event.', icon: '▥' },
  { id: 'guestbook', name: 'Gästebuch-Set', detail: 'Erinnerungen und persönliche Grüße gesammelt.', icon: '▤' },
  { id: 'homescreen', name: 'Personalisierter Homescreen', detail: 'Startbildschirm mit Namen, Logo oder Eventdesign.', icon: '▣' },
  { id: 'redcarpet', name: 'Roter Teppich & Personenleitsystem', detail: 'VIP-Auftritt für deine Gäste.', icon: '★' },
  { id: 'support', name: 'Betreuung vor Ort', detail: 'Persönliche Unterstützung während des Events.', icon: '◉' },
  { id: 'layout', name: 'Zusätzliches Drucklayout', detail: 'Eine weitere Layoutvariante für deine Bilder.', icon: '▦' },
];
---
<section class="hom-booking" id="konfigurator" aria-labelledby="hom-booking-title" style={`--hom-event-image:url("${sampleEventImage}")`}>
  <div class="shell hom-booking-shell">
    <nav class="hom-booking-progress" aria-label="Anfrageschritte">
      <a href="#angebote"><span>1</span><strong>Produkt</strong></a>
      <a href="#anfrage"><span>2</span><strong>Event</strong></a>
      <a class="is-active" href="#konfigurator" aria-current="step"><span>3</span><strong>Paket</strong></a>
      <a href="#anfrage"><span>4</span><strong>Kontakt</strong></a>
    </nav>

    <div class="hom-booking-layout">
      <div class="hom-booking-main">
        <header class="hom-booking-heading">
          <p class="eyebrow">Fotobox</p>
          <h2 id="hom-booking-title">Wähle dein Paket</h2>
          <p>Pakete und Preise werden final ergänzt. Du kannst den gewünschten Umfang schon jetzt auswählen und unverbindlich anfragen.</p>
        </header>

        <fieldset class="hom-package-list" data-hom-packages>
          <legend class="visually-hidden">Paket auswählen</legend>
          {packageOptions.map((item, index) => (
            <label class:list={['hom-package-row', { 'is-selected': item.id === 'gold' }]}>
              <input type="radio" name="homPackage" value={item.name} checked={item.id === 'gold'} />
              <span class="hom-package-copy">
                <span class="hom-package-title">
                  <strong>{item.name}</strong>
                  {item.popular && <em>Beliebt</em>}
                </span>
                <small>{item.detail}</small>
              </span>
              <span class="hom-package-price">Preis folgt</span>
              <i aria-hidden="true">{item.id === 'gold' ? '✓' : ''}</i>
            </label>
          ))}
        </fieldset>

        <div class="hom-extras-heading">
          <h3>Beliebte Extras <span>(optional)</span></h3>
        </div>
        <fieldset class="hom-extra-grid" data-hom-extras>
          <legend class="visually-hidden">Extras auswählen</legend>
          {extras.map((extra) => (
            <label class="hom-extra-card">
              <input type="checkbox" value={extra.name} />
              <span class="hom-extra-image" aria-hidden="true"><b>{extra.icon}</b></span>
              <span class="hom-extra-copy">
                <strong>{extra.name}</strong>
                <small>{extra.detail}</small>
                <em>Preis folgt</em>
              </span>
              <i aria-hidden="true">✓</i>
            </label>
          ))}
        </fieldset>

        <div class="hom-booking-actions">
          <a href="#angebote" class="hom-back">← Zurück</a>
          <a href="#anfrage" class="hom-next">Weiter zu Kontakt</a>
        </div>
      </div>

      <aside class="hom-summary" aria-label="Deine Anfrage">
        <p class="hom-summary-label">Deine Anfrage</p>
        <dl>
          <div><dt>Produkt</dt><dd>Fotobox</dd></div>
          <div><dt>Paket</dt><dd data-hom-summary-package>Gold</dd></div>
          <div><dt>Anlass</dt><dd>Event</dd></div>
          <div><dt>Datum</dt><dd>Noch offen</dd></div>
          <div><dt>Extras</dt><dd data-hom-summary-extras>Keine gewählt</dd></div>
        </dl>
        <div class="hom-summary-price">
          <small>Voraussichtlich</small>
          <strong>Preis nach Auswahl</strong>
          <span>Unverbindliche Anfrage</span>
        </div>
        <ul>
          <li>Unverbindlich & kostenlos</li>
          <li>Keine Zahlung erforderlich</li>
          <li>Persönliche Rückmeldung</li>
        </ul>
        <a href="#anfrage" class="hom-summary-cta">Weiter zu Kontakt</a>
        <div class="hom-summary-contact">
          <h3>Lieber persönlich?</h3>
          <p>Wir sind direkt für dich erreichbar.</p>
          {whatsappHref ? <a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp schreiben</a> : <span>WhatsApp wird aktiviert</span>}
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="hom-benefit-strip" aria-label="Hall of Memory Vorteile">
  <div class="shell hom-benefit-strip-grid">
    {benefits.slice(0, 5).map((benefit, index) => (
      <article>
        <span aria-hidden="true">{['◎','▤','☁','◌','♡'][index] ?? '★'}</span>
        <h3>{benefit.title}</h3>
        <p>{benefit.text}</p>
      </article>
    ))}
  </div>
</section>

<section class="hom-contact-band" aria-labelledby="hom-contact-title" style={`--hom-event-image:url("${sampleEventImage}")`}>
  <div class="shell hom-contact-band-grid">
    <div>
      <h2 id="hom-contact-title">Noch Fragen?</h2>
      <p>Wir beraten dich persönlich und finden gemeinsam das passende Erlebnis für dein Event.</p>
    </div>
    <a href="#anfrage">Unverbindlich anfragen</a>
    {whatsappHref ? <a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp schreiben</a> : <span>WhatsApp</span>}
  </div>
</section>

<section class="hom-legacy-contract" aria-hidden="true">
  {offers.map((offer) => (
    <details class="demo-offer-details"><summary>{offer.title}</summary><p>{offer.moreInfo}</p></details>
  ))}
  <span>Paket gemeinsam auswählen</span>
  <span>Beispielzugang ansehen</span>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('.hom-booking');
    if (!root) return;
    const packageOutput = root.querySelector('[data-hom-summary-package]');
    const extrasOutput = root.querySelector('[data-hom-summary-extras]');
    root.querySelectorAll('input[name="homPackage"]').forEach((input) => {
      input.addEventListener('change', () => {
        root.querySelectorAll('.hom-package-row').forEach((row) => row.classList.remove('is-selected'));
        input.closest('.hom-package-row')?.classList.add('is-selected');
        if (packageOutput) packageOutput.textContent = input.value;
      });
    });
    root.querySelectorAll('[data-hom-extras] input[type="checkbox"]').forEach((input) => {
      input.addEventListener('change', () => {
        input.closest('.hom-extra-card')?.classList.toggle('is-selected', input.checked);
        const selected = [...root.querySelectorAll('[data-hom-extras] input[type="checkbox"]:checked')].map((item) => item.value);
        if (extrasOutput) extrasOutput.textContent = selected.length ? selected.join(', ') : 'Keine gewählt';
      });
    });
  })();
</script>
