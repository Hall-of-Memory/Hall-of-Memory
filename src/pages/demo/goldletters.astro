---
import BaseLayout from '../../layouts/BaseLayout.astro';

const assetBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const glyphs = {
  A: { file: 'u0041.png', width: 193, height: 130, descent: 9 },
  E: { file: 'u0045.png', width: 128, height: 129, descent: 9 },
  M: { file: 'u004d.png', width: 190, height: 131, descent: 9 },
  N: { file: 'u004e.png', width: 186, height: 134, descent: 9 },
  O: { file: 'u004f.png', width: 136, height: 125, descent: 3 },
  R: { file: 'u0052.png', width: 156, height: 142, descent: 20 },
  S: { file: 'u0053.png', width: 144, height: 128, descent: 8 },
  T: { file: 'u0054.png', width: 132, height: 124, descent: 5 },
  V: { file: 'u0056.png', width: 164, height: 125, descent: 8 },
} as const;

const word = [...'MEMORAEVENTS'] as Array<keyof typeof glyphs>;

const glyphStyle = (letter: keyof typeof glyphs) => {
  const glyph = glyphs[letter];
  return `height:${(glyph.height / 121).toFixed(4)}em;transform:translateY(${(glyph.descent / 121).toFixed(4)}em)`;
};

const glyphSrc = (letter: keyof typeof glyphs) =>
  `${assetBase}design-lab/memoraevents-gold/${glyphs[letter].file}`;
---

<BaseLayout
  title="Memoraevents · Goldletter GitHub Pages Lab"
  description="Öffentlicher, nicht indexierter GitHub-Pages-Versuch der gegossenen Goldletter-Materialglyphen für Memoraevents."
  noIndex={true}
  bodyClass="goldletter-lab"
  formActionSource="'none'"
>
  <main id="main-content" class="lab-shell">
    <header class="lab-intro">
      <a class="back-link" href={`${assetBase}demo/`}>← Zur Preview</a>
      <p class="kicker">GitHub Pages · Goldletter Lab</p>
      <h1>MEMORAEVENTS<br /><em>in gegossenem Gold</em></h1>
      <p class="lead">
        Kein Font-Effekt: Jeder Buchstabe besteht aus den tatsächlichen Materialpixeln der
        verifizierten Goldquelle. Diese Seite prüft nur die Markenwirkung in verschiedenen Größen.
      </p>
    </header>

    <section class="lab-card signature" aria-labelledby="signature-title">
      <header class="card-heading">
        <p>01 · Signature</p>
        <h2 id="signature-title">Groß und konzentriert</h2>
        <span>Materialwirkung zuerst</span>
      </header>
      <div class="wordmark-wrap">
        <div class="material-wordmark material-wordmark-signature" aria-hidden="true">
          {word.map((letter) => (
            <span class="material-glyph">
              <img
                class="material-glyph-image"
                src={glyphSrc(letter)}
                alt=""
                width={glyphs[letter].width}
                height={glyphs[letter].height}
                style={glyphStyle(letter)}
                loading="eager"
                decoding="async"
              />
            </span>
          ))}
        </div>
        <span class="visually-hidden">MEMORAEVENTS</span>
        <p class="tagline">Erinnerungen, die Teil des Events werden.</p>
      </div>
    </section>

    <section class="lab-card editorial" aria-labelledby="editorial-title">
      <header class="card-heading">
        <p>02 · Editorial</p>
        <h2 id="editorial-title">Mehr Luft</h2>
        <span>großzügiger Zeichenabstand</span>
      </header>
      <div class="material-wordmark material-wordmark-editorial" aria-hidden="true">
        {word.map((letter) => (
          <span class="material-glyph">
            <img
              class="material-glyph-image"
              src={glyphSrc(letter)}
              alt=""
              width={glyphs[letter].width}
              height={glyphs[letter].height}
              style={glyphStyle(letter)}
              loading="lazy"
              decoding="async"
            />
          </span>
        ))}
      </div>
      <span class="visually-hidden">MEMORAEVENTS</span>
    </section>

    <section class="lab-card header-test" aria-labelledby="header-title">
      <header class="card-heading">
        <p>03 · Headerprobe</p>
        <h2 id="header-title">Kleiner Seitenmaßstab</h2>
        <span>Lesbarkeit gegen Materialdetail</span>
      </header>
      <div class="fake-header">
        <div class="material-wordmark material-wordmark-header" aria-hidden="true">
          {word.map((letter) => (
            <span class="material-glyph">
              <img
                class="material-glyph-image"
                src={glyphSrc(letter)}
                alt=""
                width={glyphs[letter].width}
                height={glyphs[letter].height}
                style={glyphStyle(letter)}
                loading="lazy"
                decoding="async"
              />
            </span>
          ))}
        </div>
        <span class="visually-hidden">MEMORAEVENTS</span>
        <nav aria-label="Beispielnavigation">
          <span>Angebote</span>
          <span>Galerie</span>
          <span>Anfrage</span>
        </nav>
      </div>
    </section>

    <section class="lab-card control" aria-labelledby="control-title">
      <header class="card-heading">
        <p>04 · Gegenprobe</p>
        <h2 id="control-title">Normale Schrift mit Goldverlauf</h2>
        <span>skalierbar, aber ohne Quellmaterial</span>
      </header>
      <p class="css-gold">MEMORAEVENTS</p>
    </section>

    <footer class="lab-notes">
      <p><strong>Quelle:</strong> Goldletter-Master 2026-09-08 · SHA-256 8555fa52…b17b1</p>
      <p><strong>Zeichensatz:</strong> nur bestätigte Großbuchstaben; keine erfundenen Kleinbuchstaben oder Sonderzeichen.</p>
      <p><strong>Status:</strong> Designpreview auf GitHub Pages, nicht Production.</p>
    </footer>
  </main>

  <style>
    :global(body.goldletter-lab) {
      margin: 0;
      min-height: 100vh;
      color: #f1eadf;
      background:
        radial-gradient(circle at 50% -12%, rgba(201, 164, 90, .18), transparent 34rem),
        linear-gradient(180deg, #080705 0%, #0d0b08 52%, #070604 100%);
    }

    .lab-shell {
      width: min(1220px, calc(100vw - 28px));
      margin-inline: auto;
      padding: 30px 0 76px;
    }

    .lab-intro {
      max-width: 900px;
      padding: 28px 4px 58px;
    }

    .back-link {
      display: inline-block;
      margin-bottom: 38px;
      color: #a99e8c;
      font-size: .72rem;
      letter-spacing: .15em;
      text-transform: uppercase;
    }

    .kicker,
    .card-heading > p {
      margin: 0 0 10px;
      color: #c9a45a;
      font-size: .68rem;
      font-weight: 700;
      letter-spacing: .19em;
      text-transform: uppercase;
    }

    .lab-intro h1 {
      margin: 0;
      font: 400 clamp(3.3rem, 7vw, 7rem)/.88 Georgia, serif;
      letter-spacing: -.05em;
    }

    .lab-intro h1 em {
      color: #dfbd69;
      font-weight: 400;
    }

    .lead {
      max-width: 720px;
      margin: 30px 0 0;
      color: #aca294;
      font-size: 1rem;
    }

    .lab-card {
      position: relative;
      min-height: 390px;
      margin-bottom: 22px;
      display: grid;
      align-content: center;
      gap: 48px;
      padding: clamp(28px, 5vw, 64px);
      overflow: hidden;
      border: 1px solid rgba(212, 177, 93, .19);
      background:
        linear-gradient(145deg, rgba(255, 236, 184, .025), transparent 38%),
        rgba(14, 12, 9, .88);
    }

    .lab-card::after {
      content: "";
      position: absolute;
      inset: 10px;
      pointer-events: none;
      border: 1px solid rgba(212, 177, 93, .055);
    }

    .card-heading {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: baseline;
      gap: 3px 24px;
    }

    .card-heading > p {
      grid-column: 1 / -1;
    }

    .card-heading h2 {
      margin: 0;
      font: 400 clamp(1.8rem, 3vw, 3rem)/1 Georgia, serif;
      letter-spacing: -.03em;
    }

    .card-heading > span {
      color: #81786b;
      font-size: .65rem;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .wordmark-wrap {
      position: relative;
      z-index: 2;
      display: grid;
      justify-items: center;
      gap: 20px;
    }

    .material-wordmark {
      max-width: 100%;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      white-space: nowrap;
      line-height: 1;
      filter: drop-shadow(0 .055em .09em rgba(0, 0, 0, .4));
    }

    .material-wordmark-signature {
      font-size: clamp(1.15rem, 4.7vw, 4.35rem);
      gap: .004em;
    }

    .material-wordmark-editorial {
      position: relative;
      z-index: 2;
      font-size: clamp(1rem, 4vw, 3.75rem);
      gap: .075em;
      padding-block: 26px;
    }

    .material-wordmark-header {
      justify-content: flex-start;
      font-size: clamp(.48rem, 1.35vw, 1.05rem);
      gap: .012em;
    }

    .material-glyph {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: flex-end;
      justify-content: center;
      line-height: 1;
    }

    .material-glyph-image {
      display: block;
      width: auto;
      max-width: none;
      object-fit: contain;
    }

    .tagline {
      margin: 0;
      color: #b4a690;
      font: italic 400 clamp(.85rem, 1.35vw, 1.05rem)/1.4 Georgia, serif;
      letter-spacing: .025em;
    }

    .editorial {
      background:
        radial-gradient(circle at 50% 55%, rgba(201, 164, 90, .08), transparent 46%),
        #090806;
    }

    .fake-header {
      position: relative;
      z-index: 2;
      min-height: 86px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
      padding-inline: 22px;
      border-block: 1px solid rgba(201, 164, 90, .2);
      background: #070604;
    }

    .fake-header nav {
      display: flex;
      gap: 24px;
      color: #b6ac9d;
      font-size: .68rem;
      letter-spacing: .09em;
      text-transform: uppercase;
    }

    .css-gold {
      position: relative;
      z-index: 2;
      margin: 0;
      text-align: center;
      font: 600 clamp(2.1rem, 6vw, 5.8rem)/1 Georgia, serif;
      letter-spacing: .035em;
      color: transparent;
      background: linear-gradient(110deg, #88611f, #f2d997 24%, #a87824 44%, #efd084 62%, #8c6523 84%, #d8b365);
      background-clip: text;
      -webkit-background-clip: text;
    }

    .lab-notes {
      display: grid;
      gap: 7px;
      padding: 24px 4px 0;
      color: #867d71;
      font-size: .74rem;
    }

    .lab-notes p {
      margin: 0;
    }

    .lab-notes strong {
      color: #c4b8a5;
    }

    @media (max-width: 720px) {
      .lab-shell {
        width: min(100% - 18px, 680px);
        padding-top: 12px;
      }

      .lab-intro {
        padding: 24px 6px 42px;
      }

      .lab-card {
        min-height: 330px;
        gap: 34px;
        padding: 28px 16px;
      }

      .card-heading {
        grid-template-columns: 1fr;
      }

      .card-heading > span {
        margin-top: 5px;
      }

      .material-wordmark-signature {
        font-size: clamp(1rem, 5.1vw, 2.3rem);
      }

      .material-wordmark-editorial {
        font-size: clamp(.84rem, 4.45vw, 1.95rem);
        gap: .045em;
      }

      .fake-header {
        padding: 18px 10px;
      }

      .fake-header nav {
        display: none;
      }

      .material-wordmark-header {
        font-size: clamp(.5rem, 2.6vw, .92rem);
      }
    }

    @media (max-width: 390px) {
      .lab-card {
        padding-inline: 11px;
      }

      .material-wordmark-signature {
        font-size: .95rem;
      }

      .material-wordmark-editorial {
        font-size: .8rem;
      }
    }
  </style>
</BaseLayout>
